{
  "name": "signalstack",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "eval": "turbo run eval --filter=@signalstack/ai --",
