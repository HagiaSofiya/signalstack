generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String?     @db.Uuid
  name        String
  description String?
  createdAt   DateTime    @default(now())
  owner       User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  datasets    Dataset[]
  agentRuns   AgentRun[]
  evalSuiteRuns EvalSuiteRun[]

  @@index([ownerId])
}

model Dataset {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  filename    String
  storagePath String
  rowCount    Int?
  columnCount  Int?
  columns     Json?
  preview     Json?
  inspectedAt DateTime?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRuns   AgentRun[]
  evalCaseResults EvalCaseResult[]

  @@index([projectId, createdAt])
}

model AgentRun {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String      @db.Uuid
  datasetId     String?     @db.Uuid
  question      String
  status        String      @default("queued")
  provider      String?
  model         String?
  tokenUsage    Int?
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  estimatedCost Decimal?    @db.Decimal(12, 6)
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  createdAt     DateTime    @default(now())
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dataset       Dataset?    @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  steps         AgentStep[]
  evalCaseResults EvalCaseResult[]

  @@index([projectId, createdAt])
  @@index([datasetId, createdAt])
}

model EvalSuiteRun {
  id                     String           @id @default(uuid()) @db.Uuid
  suiteId                String
  suiteVersion           String
  datasetVersion         String
  gitSha                 String?
  agentPromptVersion     String
  toolSchemaVersion      String
  reasoningConfig        String?
  baselineRunId          String?          @db.Uuid
  qualityPassed          Boolean
  regressionStatus       String
  thresholdFailures      Json
  baselineComparison     Json
  regressions            Json
  improvements           Json
  provider               String
  model                  String
  modelRole              String
  startedAt              DateTime
  completedAt            DateTime?
  totalCases             Int
  passedCases            Int
  passRate               Float
  toolSelectionAccuracy  Float
  numericalAccuracy      Float
  groundingRate          Float
  hallucinationFreeRate  Float
  chartSuccessRate       Float?
  averageToolCalls       Float
  averageTokens          Float?
  averageCost            Float?
  averageLatencyMs       Int
  createdAt              DateTime         @default(now())
  projectId              String?          @db.Uuid
  project                Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cases                  EvalCaseResult[]

  @@index([createdAt])
  @@index([model, createdAt])
}

model EvalCaseResult {
  id                 String       @id @default(uuid()) @db.Uuid
  suiteRunId         String       @db.Uuid
  caseId             String
  category           String
  question           String
  expected           Json
  actualToolSequence Json
  expectedFacts      Json
  observedEvidence   Json
  actualAnswer       String
  critical           Boolean
  agentRunId         String?      @db.Uuid
  datasetId          String?      @db.Uuid
  passed             Boolean
  scores             Json
  metrics            Json
  failureReason      String?
  createdAt          DateTime     @default(now())
  suiteRun           EvalSuiteRun @relation(fields: [suiteRunId], references: [id], onDelete: Cascade)
  agentRun           AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  dataset            Dataset?     @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@unique([suiteRunId, caseId])
  @@index([suiteRunId, createdAt])
  @@index([agentRunId])
  @@index([datasetId])
}

model AgentStep {
  id        String   @id @default(uuid()) @db.Uuid
  agentRunId String  @db.Uuid
  type      String
  toolName  String?
  status    String
  input     Json?
  output    Json?
  durationMs Int?
  createdAt DateTime @default(now())
  agentRun  AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId, createdAt])
}
